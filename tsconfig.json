{
	"compilerOptions": {
		"target": "es2024",
		"module": "preserve",
		"moduleResolution": "bundler",
		"lib": [
			"es2024",
			"dom"
		],
		"types": [
			"node"
		],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": true,
		"verbatimModuleSyntax": true,
		"noEmit": true
	},
	"include": [
		"src",
		"test",
		"scripts",
		"*.ts",
		"*.mts"
	],
	"exclude": [
		"test/fixtures/*/worker",
		"test/fixtures/multi-worker",
		"test/fixtures/cloudflare-config",
		"src/workers"
	]
}
